{
  "name": "jayrup-backend",
  "version": "2.0.0",
  "description": "Jayrup e-commerce API \u2013 PhonePe payments, GST invoicing, reports & SEO",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/seed/seedCatalog.js",
    "seed:catalog": "node src/seed/seedCatalog.js",
    "seed:demo": "node src/seed/seedData.js",
    "test:api": "node src/test/test-api.js",
    "smoke:pdf": "node src/test/smoke-pdf.js",
    "migrate:types": "node src/scripts/migrateProductTypes.js",
    "catalog:preview": "node src/seed/seedCatalog.js",
    "catalog:wipe": "node src/seed/seedCatalog.js --wipe --yes",
    "catalog:add": "node src/seed/seedCatalog.js --add --yes",
    "catalog:reset": "node src/seed/seedCatalog.js --reset --yes",
    "catalog:restore": "node src/seed/seedCatalog.js --yes --restore",
    "blogs:preview": "node src/seed/seedBlogs.js",
    "blogs:wipe": "node src/seed/seedBlogs.js --wipe --yes",
    "blogs:add": "node src/seed/seedBlogs.js --add --yes",
    "blogs:reset": "node src/seed/seedBlogs.js --reset --yes",
    "blogs:restore": "node src/seed/seedBlogs.js --yes --restore"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.0",
    "nodemon": "^3.1.14",
    "pdfkit": "^0.20.2",
    "validator": "^13.12.0"
  },
  "keywords": [
    "ecommerce",
    "jayrup",
    "phonepe",
    "gst",
    "invoice",
    "express",
    "mongodb"
  ],
  "author": "Jayrup",
  "license": "ISC",
  "engines": {
    "node": ">=18.17"
  }
}
