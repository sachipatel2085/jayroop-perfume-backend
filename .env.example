# ─────────────── Core ───────────────
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://jayrupcream:RelieveX2025@jayrup.0i8txkz.mongodb.net/?retryWrites=true&w=majority&appName=Jayrup
# Fix for "querySrv ECONNREFUSED": DNS servers Node uses for mongodb+srv lookups.
# Empty = automatic (public DNS in development, system DNS in production) · "system" = never change
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=RELIEVEX2025DEVELOPMENTJAYRUP
JWT_EXPIRES_IN=7d
TRUST_PROXY=1

# Public URLs
CLIENT_URL=http://localhost:5173            # storefront (PhonePe redirects customers back here)
SITE_URL=https://jayrup.in                  # canonical domain used in SEO, sitemap & schema
API_PUBLIC_URL=http://localhost:5000        # this API's public base URL (webhook URL is shown in Admin › Settings)
EXTRA_CORS_ORIGINS=                         # comma separated extra origins, e.g. https://www.jayrup.in

# Optional: serve the built React app from this server with server-side SEO tags
# FRONTEND_DIST_PATH=/home/user/jayroop-perfume-frontend/dist

# ─────────────── PhonePe Payment Gateway ───────────────
# Where to find these: business.phonepe.com → Developer Settings → API Keys
#   (toggle "Test Mode" ON in the top bar for sandbox keys, OFF for live keys).
# Full step-by-step guide: DEPLOYMENT.md → "PhonePe setup".
PHONEPE_ENV=SANDBOX                         # SANDBOX while Test Mode keys are used · PRODUCTION with live keys
# Current PhonePe accounts (2025+) – Client ID / Client Secret / Client Version
PHONEPE_CLIENT_ID=SU2601301902132623843792
PHONEPE_CLIENT_SECRET=72a0a043-ee77-47c4-8aeb-5a59906d3ee8
PHONEPE_CLIENT_VERSION=1
# Webhook – Developer Settings → Webhook → Create Webhook → type "SHA" → same username/password as here
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
# LEGACY ONLY (old PG accounts that show a Salt Key). New accounts do NOT get a salt key – leave empty.
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
# PHONEPE_API_VERSION=                      # optional: auto-detected (v2 when Client ID/Secret set, v1 when only Salt Key set)
# Local development without credentials: simulate payments (ignored in production)
PHONEPE_MOCK=false

# ─────────────── E-mail (order confirmations, password reset) ───────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=care@jayrup.in
SMTP_PASS=
MAIL_FROM="Jayrup <care@jayrup.in>"
ADMIN_NOTIFY_EMAIL=care@jayrup.in

# ─────────────── Cloudinary (media uploads) ───────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BACKEND_URL=http://localhost:5000

# "Continue with Google" – Firebase project ID (Firebase console › Project settings › General).
# Must match VITE_FIREBASE_PROJECT_ID in the frontend. Leave empty to turn Google sign-in off.
FIREBASE_PROJECT_ID=
